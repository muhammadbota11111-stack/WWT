@st.cache_data(ttl=300, show_spinner=False)
def load_history(ticker: str, period: str = "2y", interval: str = "1d"):
    raw = yf.download(
        ticker,
        period=period,
        interval=interval,
        auto_adjust=True,
        progress=False,
        threads=False,
    )
    if raw is None or raw.empty:
        return pd.DataFrame()

    # yfinance may return either flat columns or a MultiIndex.
    if isinstance(raw.columns, pd.MultiIndex):
        raw.columns = raw.columns.get_level_values(0)

    raw = raw.rename(columns=str.title)
    needed = ["Open", "High", "Low", "Close", "Volume"]
    for col in needed:
        if col not in raw.columns:
            raw[col] = np.nan

    out = raw[needed].copy()
    out = out.dropna(subset=["Close"])
    out.index = pd.to_datetime(out.index)
    if getattr(out.index, "tz", None) is not None:
        out.index = out.index.tz_localize(None)
    return out


def rsi(series: pd.Series, length: int = 14):
    delta = series.diff()
    gain = delta.clip(lower=0).ewm(alpha=1 / length, adjust=False).mean()
    loss = (-delta.clip(upper=0)).ewm(alpha=1 / length, adjust=False).mean()
    rs = gain / loss.replace(0, np.nan)
    return 100 - (100 / (1 + rs))


def add_indicators(df: pd.DataFrame):
    x = df.copy()
    close = x["Close"]
    x["EMA20"] = close.ewm(span=20, adjust=False).mean()
    x["EMA50"] = close.ewm(span=50, adjust=False).mean()
    x["EMA200"] = close.ewm(span=200, adjust=False).mean()
    x["RSI14"] = rsi(close)
    fast = close.ewm(span=12, adjust=False).mean()
    slow = close.ewm(span=26, adjust=False).mean()
    x["MACD"] = fast - slow
    x["MACD_Signal"] = x["MACD"].ewm(span=9, adjust=False).mean()

    prev_close = close.shift(1)
    tr = pd.concat(
        [
            x["High"] - x["Low"],
            (x["High"] - prev_close).abs(),
            (x["Low"] - prev_close).abs(),
        ],
        axis=1,
    ).max(axis=1)
    x["ATR14"] = tr.rolling(14).mean()
    return x


def get_latest_signal(gold: pd.DataFrame, dxy: pd.DataFrame, us10y: pd.DataFrame):
    g = add_indicators(gold).dropna(subset=["EMA50", "RSI14", "MACD_Signal", "ATR14"])
    if len(g) < 5:
        return None, []

    latest = g.iloc[-1]
    reasons = []
    score = 0

    if latest["Close"] > latest["EMA20"] > latest["EMA50"]:
        score += 2
        reasons.append("Gold price EMA20 te EMA50 ton uppar: short/medium trend positive.")
    elif latest["Close"] < latest["EMA20"] < latest["EMA50"]:
        score -= 2
        reasons.append("Gold price EMA20 te EMA50 ton thalle: short/medium trend negative.")
    else:
        reasons.append("Gold EMAs mixed ne: trend confirmation weak hai.")

    if latest["MACD"] > latest["MACD_Signal"]:
        score += 1
        reasons.append("MACD bullish momentum show kar reha hai.")
    else:
        score -= 1
        reasons.append("MACD bearish momentum show kar reha hai.")

    if latest["RSI14"] >= 55:
        score += 1
        reasons.append(f"RSI {latest['RSI14']:.1f}: momentum bullish side te hai.")
    elif latest["RSI14"] <= 45:
        score -= 1
        reasons.append(f"RSI {latest['RSI14']:.1f}: momentum bearish side te hai.")
    else:
        reasons.append(f"RSI {latest['RSI14']:.1f}: neutral zone.")

    # Cross-market context: compare most recent daily changes by date.
    for label, frame, points_if_down in [
        ("DXY", dxy, 1),
        ("US10Y yield", us10y, 1),
    ]:
        if not frame.empty and len(frame) >= 2:
            s = frame["Close"].dropna()
            change = (s.iloc[-1] / s.iloc[-2] - 1) * 100
            if change < -0.10:
                score += points_if_down
                reasons.append(f"{label} latest daily change {change:.2f}%: Gold layi supportive context.")
            elif change > 0.10:
                score -= points_if_down
                reasons.append(f"{label} latest daily change +{change:.2f}%: Gold layi pressure ho sakda hai.")
            else:
                reasons.append(f"{label} daily move chhota hai ({change:.2f}%): neutral context.")
        else:
            reasons.append(f"{label} data available nahi; cross-market point add nahi hoya.")

    if score >= 3:
        signal = "BUY BIAS"
    elif score <= -3:
        signal = "SELL BIAS"
    else:
        signal = "WAIT / NO CLEAR EDGE"

    # This is a rule score, not a probability.
    strength = min(100, int(abs(score) / 6 * 100))
    return {
        "signal": signal,
        "score": score,
        "strength": strength,
        "price": float(latest["Close"]),
        "rsi": float(latest["RSI14"]),
        "ema20": float(latest["EMA20"]),
        "ema50": float(latest["EMA50"]),
        "atr": float(latest["ATR14"]),
        "date": g.index[-1],
    }, reasons


def backtest_signals(gold: pd.DataFrame, dxy: pd.DataFrame, us10y: pd.DataFrame):
    """Signal at close t is tested against close-to-close return t -> t+1."""
    g = add_indicators(gold)
    features = pd.DataFrame(index=g.index)
    features["gold_close"] = g["Close"]
    features["ema20"] = g["EMA20"]
    features["ema50"] = g["EMA50"]
    features["rsi"] = g["RSI14"]
    features["macd"] = g["MACD"]
    features["macd_signal"] = g["MACD_Signal"]

    def daily_pct(frame):
        if frame.empty:
            return pd.Series(dtype=float)
        s = frame["Close"].dropna().pct_change() * 100
        return s

    features["dxy_change"] = daily_pct(dxy).reindex(features.index).fillna(0)
    features["yield_change"] = daily_pct(us10y).reindex(features.index).fillna(0)

    score = pd.Series(0, index=features.index, dtype=float)
    score += np.where(
        (features["gold_close"] > features["ema20"]) & (features["ema20"] > features["ema50"]),
        2,
        np.where(
            (features["gold_close"] < features["ema20"]) & (features["ema20"] < features["ema50"]),
            -2,
            0,
        ),
    )
    score += np.where(features["macd"] > features["macd_signal"], 1, -1)
    score += np.where(features["rsi"] >= 55, 1, np.where(features["rsi"] <= 45, -1, 0))
    score += np.where(features["dxy_change"] < -0.10, 1, np.where(features["dxy_change"] > 0.10, -1, 0))
    score += np.where(features["yield_change"] < -0.10, 1, np.where(features["yield_change"] > 0.10, -1, 0))

    direction = pd.Series(0, index=features.index)
    direction[score >= 3] = 1
    direction[score <= -3] = -1

    next_return = features["gold_close"].shift(-1) / features["gold_close"] - 1
    tested = pd.DataFrame({"signal": direction, "next_return": next_return}).dropna()
    tested = tested[tested["signal"] != 0]
    if tested.empty:
        return tested, None

    tested["correct"] = np.where(
        tested["signal"] == 1,
        tested["next_return"] > 0,
        tested["next_return"] < 0,
    )
    return tested, {
        "trades": int(len(tested)),
        "accuracy": float(tested["correct"].mean() * 100),
        "avg_return": float(tested["next_return"].mean() * 100),
    }


